<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>pulse</groupId><artifactId>pulse-parent</artifactId><version>1.0</version></parent>
  <artifactId>pulse-storm</artifactId>
  <description>Real-time topology: Kafka -> Storm -> HBase (runs on the storm:2.8.9 image, JRE 17)</description>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <storm.version>2.8.9</storm.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.storm</groupId><artifactId>storm-client</artifactId>
      <version>${storm.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.storm</groupId><artifactId>storm-kafka-client</artifactId><version>${storm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.kafka</groupId><artifactId>kafka-clients</artifactId><version>3.9.1</version>
    </dependency>
    <!-- Shaded HBase client: no Hadoop/Guava/Netty clashes inside Storm workers -->
    <dependency>
      <groupId>org.apache.hbase</groupId><artifactId>hbase-shaded-client</artifactId><version>2.5.16-hadoop3</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.17.2</version>
    </dependency>

    <dependency>
      <groupId>org.apache.storm</groupId><artifactId>storm-server</artifactId>
      <version>${storm.version}</version><scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version><scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>pulse-storm</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase><goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <!-- Our Jackson must not collide with the one on Storm's worker classpath -->
              <relocations>
                <relocation><pattern>com.fasterxml.jackson</pattern><shadedPattern>pulse.shaded.jackson</shadedPattern></relocation>
              </relocations>
              <filters><filter><artifact>*:*</artifact>
                <excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                  <exclude>META-INF/versions/**/module-info.class</exclude></excludes>
              </filter></filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
