<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>pulse</groupId>
    <artifactId>pulse-parent</artifactId>
    <version>1.0</version>
  </parent>
  <artifactId>pulse-hadoop</artifactId>
  <description>Pig UDF (ParseGhEvent) and MapReduce jobs; runs on the cluster's Java 8</description>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
  </properties>

  <dependencies>
    <!-- Supplied by the cluster at runtime -->
    <dependency>
      <groupId>org.apache.hadoop</groupId><artifactId>hadoop-client</artifactId>
      <version>${hadoop.version}</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.pig</groupId><artifactId>pig</artifactId>
      <version>0.18.0</version><scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>joda-time</groupId><artifactId>joda-time</artifactId><version>2.9.9</version><scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId>
      <version>2.12.7.1</version><scope>provided</scope>
    </dependency>
    <!-- Mahout 0.13 vector classes for the k-means helper (the cluster provides them at runtime) -->
    <dependency>
      <groupId>org.apache.mahout</groupId><artifactId>mahout-mr</artifactId><version>0.13.0</version><scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.mahout</groupId><artifactId>mahout-hdfs</artifactId><version>0.13.0</version><scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.mahout</groupId><artifactId>mahout-math</artifactId><version>0.13.0</version><scope>provided</scope>
      <exclusions><exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion></exclusions>
    </dependency>
    <!-- Same Parquet version as Hive 3.1.3; shaded in so MapReduce tasks can read the clean zone -->
    <dependency>
      <groupId>org.apache.parquet</groupId><artifactId>parquet-hadoop-bundle</artifactId><version>1.10.0</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version><scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>pulse-hadoop</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase><goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters><filter><artifact>*:*</artifact>
                <excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude></excludes>
              </filter></filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
