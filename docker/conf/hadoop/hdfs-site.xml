<?xml version="1.0"?>
<configuration>
  <property><name>dfs.replication</name><value>2</value></property>
  <!-- 64 MB blocks: an ~90 MB hourly GH Archive file spans 2 blocks, which makes the fsck demo interesting -->
  <property><name>dfs.blocksize</name><value>67108864</value></property>
  <property><name>dfs.namenode.name.dir</name><value>/data/nn</value></property>
  <property><name>dfs.datanode.data.dir</name><value>/data/dn</value></property>
  <property><name>dfs.namenode.rpc-bind-host</name><value>0.0.0.0</value></property>
  <property><name>dfs.namenode.http-address</name><value>0.0.0.0:9870</value></property>
  <property><name>dfs.namenode.datanode.registration.ip-hostname-check</name><value>false</value></property>
  <!-- Containers address each other by service name, not by Docker-internal IPs -->
  <property><name>dfs.client.use.datanode.hostname</name><value>true</value></property>
  <property><name>dfs.datanode.use.datanode.hostname</name><value>true</value></property>
  <property><name>dfs.webhdfs.enabled</name><value>true</value></property>
  <!-- Dead-DataNode detection in ~90 s instead of 10.5 min, for the kill-a-DataNode demo -->
  <property><name>dfs.namenode.heartbeat.recheck-interval</name><value>30000</value></property>
</configuration>
